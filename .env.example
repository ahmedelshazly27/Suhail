# Copy to .env.local for local work. Real values live in Vercel (Preview uses staging, Production uses production).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://suhail-lemon.vercel.app
TEAM_HOST=                      # e.g. team.suhail.build, once the domain is connected
TEAM_TZ=Asia/Kuwait

# Email (Resend, domain suhail.build)
RESEND_API_KEY=
RESEND_AUDIENCE_ID_AR=          # Resend segment id, Arabic subscribers
RESEND_AUDIENCE_ID_EN=          # Resend segment id, English subscribers
RESEND_WEBHOOK_SECRET=
MAIL_FROM=Suhail <hello@suhail.build>
MAIL_ALLOWLIST=admin@afterwave.org   # safety switch: only these get real mail; "*" lets everyone (and enables broadcasts)
MAIL_SAFE_TO=admin@afterwave.org     # where everything else is redirected while the switch is on

# Bot protection (Cloudflare's published test keys are used when these are empty)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sign-in
DEV_LOGIN=1                     # owner-only email link until Microsoft sign-in works; never 1 in Production
OWNER_EMAIL=admin@afterwave.org

# Microsoft 365 (Entra ID app). Everything Microsoft switches on when these three are set.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Object IDs of the Entra security groups that grant dashboard access (docs/microsoft.md)
AZURE_GROUP_OWNERS=
AZURE_GROUP_ADMINS=
AZURE_GROUP_TEAM=
SHAREPOINT_DRIVE_ID=            # the "Suhail" team site document library
SHARED_MAILBOXES=hello@suhail.build,partners@suhail.build,tasks@suhail.build
TASKS_MAILBOX=tasks@suhail.build
TEAMS_WEBHOOK_URL=              # Workflows webhook for the team channel
MICROSOFT_BOT_ID=
MICROSOFT_BOT_PASSWORD=
ANTHROPIC_API_KEY=              # v2: meeting notes into draft tickets

# Server secrets
CRON_SECRET=                    # Vercel Cron sends it as a bearer token
TOKEN_ENCRYPTION_KEY=           # encrypts Microsoft refresh tokens at rest
